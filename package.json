{
    "name": "components",
    "private": true,
    "license": "MIT",
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "registry:build": "rm -rf public/r && mkdir -p public/r && shadcn build",
        "registry:validate": "shadcn registry validate",
        "registry:list": "shadcn list GDanielRG/components",
        "registry:check": "bun run format:check && bun run registry:validate && bun run registry:build",
        "registry:release": "bun scripts/release.mjs",
        "parity:lock": "bun scripts/parity-lock.mjs",
        "parity:report": "bun scripts/parity-report.mjs",
        "smoke": "bun scripts/smoke-baseline.mjs",
        "test": "vitest run"
    },
    "devDependencies": {
        "@base-ui/react": "^1.7.0",
        "@inertiajs/core": "^3.5.0",
        "@inertiajs/react": "^3.5.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "jsdom": "^29.1.1",
        "lucide-react": "^1.27.0",
        "prettier": "3.9.6",
        "react": "^19.2.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.7",
        "shadcn": "4.15.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "vitest": "^4.1.8"
    }
}
