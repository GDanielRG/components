{
    "name": "components",
    "private": true,
    "license": "MIT",
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "registry:build": "rm -rf public/r && mkdir -p public/r && shadcn build",
        "registry:validate": "shadcn registry validate",
        "registry:list": "shadcn list GDanielRG/components",
        "registry:check": "bun run format:check && bun run registry:validate && bun run registry:build && bun scripts/check-bun-dependencies.mjs",
        "registry:release": "bun scripts/release.mjs",
        "registry:drift": "bun scripts/drift.mjs",
        "smoke": "bun scripts/smoke-baseline.mjs",
        "test": "vitest run"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@inertiajs/core": "^3.9.1",
        "@inertiajs/react": "^3.9.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "jsdom": "^30.1.3",
        "lucide-react": "^1.61.0",
        "prettier": "3.9.10",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "shadcn": "4.22.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "vitest": "^5.0.5"
    }
}
