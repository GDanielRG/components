{
    "rules": {
        "shadcn/no-restyle": [
            "error",
            {
                "allow": ["layout"]
            }
        ],
        "shadcn/no-raw-colors": [
            "error",
            {
                "scanAllStrings": true
            }
        ],
        "shadcn/no-arbitrary-values": [
            "error",
            {
                "scanAllStrings": true
            }
        ],
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error",
        "shadcn/require-static-classes": "error"
    },
    "overrides": [
        {
            "files": ["resources/js/components/ui/**"],
            "rules": {
                "shadcn/no-restyle": "off",
                "shadcn/no-arbitrary-values": "off",
                "shadcn/require-static-classes": "off"
            }
        },
        {
            "files": ["resources/js/components/dialog-form-content.tsx"],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^DialogContent$",
                                "allow": ["layout", "p-0"]
                            }
                        ]
                    }
                ],
                "shadcn/no-arbitrary-values": [
                    "error",
                    {
                        "scanAllStrings": true,
                        "allow": ["max-h-[calc(100dvh-2rem)]"]
                    }
                ]
            }
        },
        {
            "files": ["resources/js/components/dialog-form-layout.tsx"],
            "rules": {
                "shadcn/no-arbitrary-values": [
                    "error",
                    {
                        "scanAllStrings": true,
                        "allow": ["grid-cols-[1fr_auto]"]
                    }
                ]
            }
        },
        {
            "files": [
                "resources/js/components/activity/comment-typing-indicator.tsx"
            ],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^MarkerContent$",
                                "allow": ["layout", "shimmer"]
                            }
                        ]
                    }
                ],
                "shadcn/no-arbitrary-values": [
                    "error",
                    {
                        "scanAllStrings": true,
                        "allow": [
                            "grid-rows-[0fr]",
                            "grid-rows-[1fr]",
                            "transition-[grid-template-rows,opacity]"
                        ]
                    }
                ]
            }
        },
        {
            "files": ["resources/js/components/chat/message-scroller.tsx"],
            "rules": {
                "shadcn/no-arbitrary-values": [
                    "error",
                    {
                        "scanAllStrings": true,
                        "allow": [
                            "[content-visibility:auto]",
                            "[contain-intrinsic-size:auto_10rem]"
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "resources/js/components/activity/comments-documents-sidebar.tsx"
            ],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^SidebarHeader$",
                                "allow": ["layout", "px-4", "lg:px-0"]
                            },
                            {
                                "pattern": "^SidebarContent$",
                                "allow": [
                                    "layout",
                                    "rounded-xl",
                                    "border",
                                    "bg-background",
                                    "shadow-sm",
                                    "lg:border-0"
                                ]
                            },
                            {
                                "pattern": "^SidebarFooter$",
                                "allow": [
                                    "layout",
                                    "px-4",
                                    "lg:px-0",
                                    "lg:pb-0",
                                    "lg:pt-4",
                                    "pt-0"
                                ]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["resources/js/components/app-empty-card.tsx"],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^Empty$",
                                "allow": ["layout", "border"]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "resources/js/components/search/{faceted-filters,range-filter,select-filter}.tsx"
            ],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^Button$",
                                "allow": ["layout", "border-dashed"]
                            },
                            {
                                "pattern": "^FieldGroup$",
                                "allow": ["layout", "gap-3"]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "resources/js/components/documents/{document-item,documents-panel-item}.tsx"
            ],
            "rules": {
                "shadcn/no-restyle": [
                    "error",
                    {
                        "allow": ["layout"],
                        "contracts": [
                            {
                                "pattern": "^FieldGroup$",
                                "allow": ["layout", "gap-2"]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
